torageType\": string, \"datastoreUrn\": string, \"snapUuid\": string, \"snapIscsi\": string, \"sdUrn\": string, \"sdUri\": string, \"volCBTCreateTime\": string, \"ChgID\": string } ] ] } | HTTP/1.1 200 OK Date: Mon, 12 Nov 2007 15:55:01 GMT Content-Type: application/json; charset=UTF-8 { \"total\": integer, \"vmSnapShots\": [ \"urn\": string, \"uri\": string, \"name\": string, \"type\": string, \"description\": string, \"createTime\": string, \"status\": \"resuming\", \"snapProvisionSize\": long, \"coreNum\": integer, \"memorySize\": integer, \"volumeSizeSum\": long, \"volsnapshots\": [ { \"volumeUrn\": string, \"volumeUri\": string, \"storageType\": string, \"datastoreUrn\": string, \"snapUuid\": string, \"snapIscsi\": string, \"sdUrn\": string, \"sdUri\": string, \"volCBTCreateTime\": string, \"ChgID\": string } ] ] } | HTTP/1.1 200 OK Date: Mon, 12 Nov 2007 15:55:01 GMT Content-Type: application/json; charset=UTF-8 { \"total\": integer, \"vmSnapShots\": [ \"urn\": string, \"uri\": string, \"name\": string, \"type\": string, \"description\": string, \"createTime\": string, \"status\": \"resuming\", \"snapProvisionSize\": long, \"coreNum\": integer, \"memorySize\": integer, \"volumeSizeSum\": long, \"volsnapshots\": [ { \"volumeUrn\": string, \"volumeUri\": string, \"storageType\": string, \"datastoreUrn\": string, \"snapUuid\": string, \"snapIscsi\": string, \"sdUrn\": string, \"sdUri\": string, \"volCBTCreateTime\": string, \"ChgID\": string } ] ] } |\n| 错误码 | HTTP状态码 | Error Code | 描述 | 描述 | 描述 | 描述 | 描述 |\n| 错误码 | 400 | 10000004 | 操作数据库异常。 | 操作数据库异常。 | 操作数据库异常。 | 操作数据库异常。 | 操作数据库异常。 |\n\n\n创建虚拟机快照\n\n\n| 接口功能 | createVmSnapshot，创建当前时间点该虚拟机快照。每个虚拟机最多可以创32个普通虚拟机快照，每个虚拟机最多可以创32个备份虚拟机快照。 | createVmSnapshot，创建当前时间点该虚拟机快照。每个虚拟机最多可以创32个普通虚拟机快照，每个虚拟机最多可以创32个备份虚拟机快照。 | createVmSnapshot，创建当前时间点该虚拟机快照。每个虚拟机最多可以创32个普通虚拟机快照，每个虚拟机最多可以创32个备份虚拟机快照。 |\n| --- | --- | --- | --- |\n| 接口描述 | Name | 请求正文描述 | 请求正文描述 |\n| 接口描述 | Attribute | Type | Description |\n| 接口描述 | name | string | 必选。虚拟机快照的名称。[1,256] |\n| 接口描述 | description | string | 可选。虚拟机快照的描述。[0,1024] |\n| 接口描述 | needMemoryShot | boolean | 可选。是否制作内存快照，默认false |\n| 接口描述 | memoryShotTimeOut | integer | 内存快照超时时间，单位分钟，可选，仅在needMemoryShot为true时生效。 取值范围0或[5，35791394]，默认0即不超时。 |\n| 接口描述 | isConsistent | boolean | 可选。默认false，是否一致性快照，预留参数，携带参数表明该快照会保证虚拟机数据一致性，在虚拟机运行时会执行VSS功能，将缓存数据刷到磁盘上，当选择内存快照或虚拟机关机时，该参数不起作用。 |\n| 接口描述 | type | string | 可选。快照类型，枚举如下： 普通快照：normal 备份点快照：backup CBT备份：CBTbackup 安全快照：secure 默认为normal |\n| 接口描述 | protectPeriod | integer | 安全快照保护周期[1,7300]天 |\n| 接口描述 | isMasterOnly | boolean | 可选。默认false，高可用虚拟机是否仅在主端存储创建快照，如果仅在主端创建快照，主备切换后会丢失快照信息。仅在分布式高可用虚拟机创建非一致性CBT快照场景下，该参数被设置为true有意义，其余场景该参数默认被设置为false，该参数为false时，快照创建过程保持原逻辑。如果该参数生效并且为true，将仅在主端存储创建快照。 |\n| 接口描述 | Name | 响应正文描述 | 响应正文描述 |\n| 接口描述 | Attribute | Type | Description |\n| 接口描述 | urn | string | 快照标识 |\n| 接口描述 | uri | string | 快照访问uri |\n| 接口描述 | taskUrn | string | 创建虚拟机快照对应的任务标识 |\n| 接口描述 | taskUri | string | 访问该创建任务的uri |\n| 请求样例 | Post <vmsnapshot_uri> HTTP/1.1 Host: https://<ip>:<port> Content-Type: application/json; charset=UTF-8 Accept: application/json;version=<version>; charset=UTF-8 X-Auth-Token: <Authen_TOKEN> { \"name\": string, \"description\": string, \"needMemoryShot\": boolean, \"isConsistent\": boolean, \"type\": string } | Post <vmsnapshot_uri> HTTP/1.1 Host: https://<ip>:<port> Content-Type: application/json; charset=UTF-8 Accept: application/json;version=<version>; charset=UTF-8 X-Auth-Token: <Authen_TOKEN> { \"name\": string, \"description\": string, \"needMemoryShot\": boolean, \"isConsistent\": boolean, \"type\": string } | Post <vmsnapshot_uri> HTTP/1.1 Host: https://<ip>:<port> Content-Type: application/json; charset=UTF-8 Accept: application/json;version=<version>; charset=UTF-8 X-Auth-Token: <Authen_TOKEN> { \"name\": string, \"description\": string, \"needMemoryShot\": boolean, \"isConsistent\": boolean, \"type\": string } |\n| 响应样例 | HTTP/1.1 200 OK Date: Mon, 12 Nov 2007 15:55:01 GMT Content-Type: application/json; charset=UTF-8 { \"urn\": string, \"uri\": string, \"taskUrn\": string, \"taskUri\": string } | HTTP/1.1 200 OK Date: Mon, 12 Nov 2007 15:55:01 GMT Content-Type: application/json; charset=UTF-8 { \"urn\": string, \"uri\": string, \"taskUrn\": string, \"taskUri\": string } | HTTP/1.1 200 OK Date: Mon, 12 Nov 2007 15:55:01 GMT Content-Type: application/json; charset=UTF-8 { \"urn\": string, \"uri\": string, \"taskUrn\": string, \"taskUri\": string } |\n| 错误码 | HTTP状态码 | Error Code | 描述 |\n| 错误码 | 400 | 10000012 | 入参name非法。 |\n| 错误码 | 400 | 10000018 | “描述”参数不合法，请重新输入。 |\n| 错误码 | 400 | 10000019 | “是否制作内存快照”参数不合法，请重新输入。 |\n| 错误码 | 400 | 10000020 | “是否一致性快照”参数不合法，请重新输入。 |\n| 错误码 | 400 | 10300100 | 虚拟机存在共享磁盘，不能进行该操作。 |\n| 错误码 | 400 | 10300060 | 磁盘类型不允许当前操作。 |\n| 错误码 | 400 | 10300112 | 快照任务正在进行中，单个虚拟机不能同时做多个快照 |\n| 错误码 | 400 | 10300111 | 虚拟机快照数量或虚拟机磁盘快照数量已达上限，不能继续创建。 |\n| 错误码 | 500 | 11000000 | 系统内部异常，请联系技术支持人员。 |\n| 错误码 | 400 | 10300119 | 停止态虚拟机不允许做带内存的快照，请取消内存快照后重试。 |\n| 错误码 | 400 | 10300141 | 虚拟机模板不允许创建快照，请转为虚拟机后重试。 |\n| 错误码 | 400 | 10300142 | 该虚拟机为链接克隆虚拟机，不允许创建快照。 |\n| 错误码 | 400 | 10300015 | 虚拟机不允许此操作 |\n| 错误码 | 400 | 10300018 | 虚拟机所属的数据存储类型不支持创建快照 |\n| 错误码 | 400 | 10300116 | 休眠态虚拟机必须创建内存快照，请勾选内存快照后重试。 |\n| 错误码 | 400 | 10300026 | 虚拟机Tools未启动，请稍后重试。 |\n| 错误码 | 400 | 10300314 | 存在不受快照影响磁盘的虚拟机不能做内存快照。 |\n| 错误码 | 400 | 10300162 | 对此虚拟机/模板当前的操作和未完成的任务存在冲突，待任务完成后重试。 |\n| 错误码 | 400 | 10300164 | CPU或内存热插拔操作完成，请在重启虚拟机之后创建快照。 |\n| 错误码 | 400 | 10300168 | 该虚拟机绑定了USB设备，不能创建内存快照。 |\n| 错误码 | 400 | 10300318 | 该虚拟机已存在快照任务，请等待快照任务执行成功后再进行下一次快照任务。 |\n| 错误码 | 400 | 10300319 | 主机恢复挂起的虚拟机失败。 |\n| 错误码 | 400 | 10300330 | 磁盘不存在，或没有绑定虚拟机。 |\n| 错误码 | 400 | 10300421 | 虚拟机磁盘存在未完成任务，请任务结束后重试。 |\n| 错误码 | 400 | 10800185 | 安全用户虚拟机只能创建普通快照。 |\n| 错误码 | 400 | 10300626 | 集群性能优化配置参数不合法。 |\n| 错误码 | 400 | 10300631 | hana配置下的VM，内存小于等于1000G，才允许此操作。 |\n| 错误码 | 400 | 10321011 | 虚拟机操作系统不支持创建一致性快照。 |\n| 错误码 | 400 | 10321019 | 虚拟机操作系统不支持创建内存快照。 |\n| 错误码 | 400 | 10300848 | 使用SR-IOV网卡的虚拟机不能创建内存快照